# =========================================
# App
# =========================================
APP_NAME=robot-scalping
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# =========================================
# API server
# =========================================
API_HOST=0.0.0.0
API_PORT=8000

# =========================================
# MetaTrader 5
# =========================================
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# =========================================
# XAUUSD trading
# =========================================
XAUUSD_SYMBOL=XAUUSD.m
XAUUSD_LOT_SIZE=0.01
# Override filling mode order kalau auto-detect salah (FOK/IOC/RETURN). Kosongkan buat auto-detect.
MT5_FILLING_MODE=
# Nama file CSV trade log live (di dataset/live/m5_scalping/). Ganti nilai ini (bukan edit
# kode) kalau strategi live pindah versi & butuh file trade log baru -- juga dibaca oleh
# fitur bot_telegram (laporan & evaluasi kondisi market).
M5_SCALPING_TRADE_LOG_FILENAME=trade_log_v13.csv

# Drawdown kill-switch (persen, dari equity). Daily/monthly reset otomatis tiap
# hari/bulan baru (UTC). Total dihitung dari peak equity tertinggi & pause PERMANEN
# sampai direset manual (hapus dataset/live/m5_scalping/drawdown_state.json --
# JANGAN hapus trade_log.csv, itu file histori trade yang beda & tidak terkait).
# Nilai divalidasi via backtest (notebooks/m5_scalping/v09_drawdown_killswitch.ipynb):
# max drawdown historis strategi v06 = -28.4%, jadi threshold di bawah itu (mis. 5/10/15)
# bikin robot mati permanen di awal (trade ke-102 dari 1664). 20/25/40 tervalidasi tidak
# pernah ke-trigger di seluruh backtest, tetap jadi jaring pengaman kalau live menyimpang
# jauh dari backtest.
MAX_DAILY_DRAWDOWN_PCT=20.0
MAX_MONTHLY_DRAWDOWN_PCT=25.0
MAX_TOTAL_DRAWDOWN_PCT=40.0

# =========================================
# Telegram Bot
# =========================================
TELEGRAM_CHAT_ID=
TELEGRAM_TOKEN_XAUUSD=
# Cuma user Telegram ID ini yang boleh pakai /start_tuning_* & tombol resume kill-switch.
TELEGRAM_ALLOWED_USER_ID=
# Semua laporan otomatis jam 01:00 UTC = 08:00 WIB.
TELEGRAM_DAILY_REPORT_HOUR_UTC=1
TELEGRAM_WEEKLY_REPORT_HOUR_UTC=1
TELEGRAM_WEEKLY_REPORT_WEEKDAY=0
TELEGRAM_MONTHLY_REPORT_HOUR_UTC=1
TELEGRAM_REPORTS_ENABLED=true
